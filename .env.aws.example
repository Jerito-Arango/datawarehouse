# Plantilla de .env.aws. El real lo genera scripts/aws/make_env.sh con "terraform output". No contiene contraseñas.
AWS_DEFAULT_REGION=us-east-2
S3_BUCKET=dw-user10-<id-de-cuenta>
RDS_ENDPOINT=<nombre>.<id>.us-east-2.rds.amazonaws.com
DOCDB_ENDPOINT=<nombre>.cluster-<id>.us-east-2.docdb.amazonaws.com
REDSHIFT_ENDPOINT=<workgroup>.<cuenta>.us-east-2.redshift-serverless.amazonaws.com
REDSHIFT_ROLE_ARN=arn:aws:iam::<cuenta>:role/<rol-redshift-s3>
RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-2:<cuenta>:secret:rds!db-<id>
REDSHIFT_SECRET_ARN=arn:aws:secretsmanager:us-east-2:<cuenta>:secret:redshift!<namespace>-dwadmin-<id>
EC2_PUBLIC_IP=<ip-publica-de-la-ec2>
